# 실험용 브라우저 공개 설정. 비밀키를 입력하지 않습니다.
# NAVER Cloud Web 서비스 URL에 localhost와 Vercel 배포 도메인을 등록합니다.
VITE_NAVER_MAPS_CLIENT_ID=

# 공고지도 체험 설문
VITE_TALLY_FORM_ID=jadN9a

# 실험 전용 PostHog 공개 프로젝트 키와 수집 호스트(운영 프로젝트와 분리).
# 둘 다 설정해야 수집하며, 누락 시 체험·설문은 계속 동작하지만 분석 수집은 꺼집니다.
# 호스트: https://us.i.posthog.com 또는 https://eu.i.posthog.com
VITE_STUDY_POSTHOG_KEY=
VITE_STUDY_POSTHOG_HOST=
